/* ============================================================
   设计点漫游壳 · 样式
   原则：壳比界面弱。浅中性基底 + 一种衬线只用于标题 +
        一个低饱和强调色只用于进度与当前项。
   如果项目已有设计系统，用项目的令牌替换 :root。
   ============================================================ */

:root {
  color-scheme: light;

  /* 面 */
  --paper: #f5f5f5;
  --white: #fff;
  --surface: #f8f8f8;
  --line: #e5e5e5;
  --line-strong: #d8d8d8;

  /* 字 */
  --ink: #25252a;
  --muted: #777a83;
  --quiet: #999ba2;

  /* 操作 */
  --action: #191a1b;
  --action-hover: #303132;

  /* 强调：只用于进度、当前项、载入圈 */
  --accent: #5366c8;
  --accent-soft: #edf0ff;

  --serif: "Noto Serif SC", "Songti SC", "STSong", Georgia, serif;

  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
  background: var(--paper);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; min-width: 320px; margin: 0; overflow: hidden; }
button { color: inherit; font: inherit; }
button:focus-visible, [role="button"]:focus-visible { outline: none; }

/* ---------- 容器 ---------- */
.showcase { position: fixed; inset: 0; overflow: hidden; background: var(--paper); }

/* 现场层 */
.demo-frame {
  position: absolute; inset: 0; display: block; width: 100%; height: 100%;
  border: 0; background: var(--paper); opacity: 1; transition: opacity 180ms ease;
}
.showcase[data-view="cover"] .demo-frame,
.showcase[data-view="closing"] .demo-frame { visibility: hidden; opacity: 0; }
.showcase[data-view="loading"] .demo-frame { opacity: .45; }   /* 半透明遮罩，避免白闪后再跳 */

/* ---------- 封面 ---------- */
.chapter-cover {
  position: absolute; inset: 0; z-index: 5; display: none;
  grid-template-rows: auto minmax(0, 1fr) auto;
  padding: clamp(24px, 4.1vw, 64px) clamp(24px, 6.2vw, 104px) 26px;
  /* 两团极淡的光晕，一冷一暖，把视线留在标题区 */
  background:
    radial-gradient(ellipse at 77% 36%, rgba(229, 233, 255, .66), transparent 38%),
    radial-gradient(ellipse at 12% 92%, rgba(243, 228, 221, .44), transparent 31%),
    #f7f7f6;
}
.showcase[data-view="cover"] .chapter-cover { display: grid; }

.cover-brand { display: flex; align-items: center; gap: 11px; color: #5e626c; font-size: 11px; font-weight: 720; letter-spacing: .14em; }
.cover-brand > i { width: 30px; height: 1px; margin: 0 2px; background: #c9cbd0; }
.cover-brand-lockup { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
.cover-brand-lockup img { display: block; width: 75px; height: 30px; object-fit: contain; object-position: left center; }
.cover-brand-lockup .brand-word { color: #33343a; font-size: 14px; font-weight: 600; letter-spacing: -.15px; text-transform: none; }
/* 没有 logo 时的首字母方块，有 logo 就删掉这段 */
.brand-fallback { display: grid; width: 26px; height: 26px; place-items: center; border-radius: 7px; background: var(--action); color: #fff; font: 600 14px/1 var(--serif); letter-spacing: 0; }

.cover-main {
  display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(320px, .72fr);
  gap: clamp(34px, 7.8vw, 132px); align-items: center;
  max-width: 1320px; width: 100%; margin: auto; padding: 36px 0 54px;
}
.cover-copy { max-width: 680px; }
.cover-eyebrow { margin: 0 0 22px; color: #626775; font-size: 12px; font-weight: 650; letter-spacing: .07em; }
.cover-number { margin: 0 0 14px; color: #c5c8d3; font: 400 clamp(44px, 6.2vw, 84px)/.9 var(--serif); letter-spacing: -.06em; }
.cover-copy h1 { max-width: 680px; margin: 0; color: #22232a; font: 500 clamp(36px, 5.2vw, 68px)/1.2 var(--serif); letter-spacing: -.035em; }
.cover-description { max-width: 560px; margin: 22px 0 0; color: #646873; font-size: clamp(14px, 1.2vw, 17px); line-height: 1.8; }

/* 访谈原声：封面上的证据，不是装饰 */
.cover-voices { display: grid; max-width: 560px; gap: 10px; margin-top: 18px; }
.cover-voice { margin: 0; padding-left: 13px; border-left: 1px solid #b9bdc8; }
.cover-voice blockquote { margin: 0; color: #474a54; font-size: clamp(12px, 1vw, 14px); line-height: 1.55; }
.cover-voice figcaption { margin-top: 3px; color: #777b85; font-size: 10px; line-height: 1.4; }

.cover-actions { display: flex; align-items: center; gap: 24px; margin-top: 34px; }

/* 章节插画：讲处境，所以不截 UI */
.cover-art-stage { display: grid; place-items: center; justify-self: center; width: min(130%, 680px); min-width: 0; aspect-ratio: 3 / 2; }
.cover-art-stage img { display: block; width: 100%; height: 100%; object-fit: contain; }
.cover-art-stage[hidden] { display: none; }

.cover-footer { display: flex; justify-content: space-between; gap: 20px; color: #90929a; font-size: 11px; letter-spacing: .02em; }

/* ---------- 收尾页 ---------- */
.closing-page {
  position: absolute; inset: 0; z-index: 5; display: none;
  grid-template-rows: auto minmax(0, 1fr) auto;
  padding: clamp(24px, 4.1vw, 64px) clamp(24px, 6.2vw, 104px) 26px;
  background:
    radial-gradient(ellipse at 78% 18%, rgba(220, 228, 255, .82), transparent 37%),
    radial-gradient(ellipse at 12% 88%, rgba(245, 223, 225, .6), transparent 34%),
    radial-gradient(ellipse at 52% 100%, rgba(224, 235, 229, .54), transparent 42%),
    #f7f7f6;
}
.showcase[data-view="closing"] .closing-page { display: grid; }
.closing-main { display: grid; align-content: center; gap: clamp(32px, 5vh, 56px); width: 100%; max-width: 1380px; margin: auto; padding: 40px 0 48px; }
.closing-heading { text-align: center; }
.closing-heading .cover-eyebrow { margin: 0 0 12px; }
.closing-heading h1 { margin: 0; color: #22232a; font: 500 clamp(36px, 4.7vw, 62px)/1.2 var(--serif); letter-spacing: -.035em; }

/* 三栏玻璃卡：一栏一句，靠在一起读，不拆成三张卡 */
.closing-voices {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .84); border-radius: 22px;
  background: linear-gradient(118deg, rgba(255, 255, 255, .8), rgba(255, 255, 255, .56) 52%, rgba(255, 255, 255, .74));
  box-shadow: 0 24px 70px rgba(70, 77, 110, .08);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
}
.closing-voice { position: relative; display: flex; min-height: clamp(280px, 34vh, 360px); flex-direction: column; padding: clamp(22px, 3vw, 42px); }
.closing-voice + .closing-voice { border-left: 1px solid rgba(104, 111, 139, .16); }
.closing-index { color: #989baa; font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; }
.closing-mark { position: absolute; top: 46px; right: clamp(22px, 3vw, 42px); color: rgba(91, 105, 174, .18); font: 400 clamp(70px, 9vw, 120px)/.8 var(--serif); }
.closing-voice:nth-child(2) .closing-mark { color: rgba(169, 116, 137, .18); }
.closing-voice:nth-child(3) .closing-mark { color: rgba(84, 135, 117, .19); }
.closing-voice blockquote { position: relative; z-index: 1; display: flex; flex: 1; align-items: center; margin: 14px 0 30px; color: #272831; font: 500 clamp(23px, 2.1vw, 31px)/1.58 var(--serif); letter-spacing: -.02em; }
.closing-voice figcaption { display: grid; gap: 4px; color: #535762; }
.closing-voice figcaption strong { font-size: 13px; font-weight: 650; }
.closing-voice figcaption span { color: #70747f; font-size: 11px; font-weight: 500; line-height: 1.4; }

.closing-footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; max-width: 1380px; width: 100%; margin: 0 auto; }
.closing-actions { display: flex; align-items: center; gap: 25px; }
.closing-footer .text-button { color: #666a74; }

/* ---------- 按钮 ---------- */
.primary-button, .text-button, .icon-button { border: 0; cursor: pointer; }
.primary-button {
  display: inline-flex; align-items: center; justify-content: center; gap: 18px;
  min-height: 42px; padding: 0 18px; border-radius: 8px;
  background: var(--action); color: #fff; font-size: 13px; font-weight: 620;
  transition: background .16s ease, transform .16s ease;
}
.primary-button:hover { background: var(--action-hover); transform: translateY(-1px); }
.text-button { padding: 8px 0; background: transparent; color: #626671; font-size: 13px; }
.text-button:hover { color: var(--ink); }
.icon-button { display: grid; width: 27px; height: 27px; place-items: center; border-radius: 6px; background: transparent; color: #737680; font-size: 19px; line-height: 1; }
.icon-button:hover { background: #f2f2f3; color: var(--ink); }

/* ============================================================
   批注条 —— 这个壳的主角
   一条 80% 黑的半透明文字条，不是一张卡片：
   能压住浅色界面，又不切断界面（透过去还能看见内容）。
   ============================================================ */
.design-note {
  position: absolute; z-index: 4;
  left: max(22px, env(safe-area-inset-left));
  bottom: max(22px, env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 8px;
  max-width: calc(100vw - 44px);
  color: #fff;
  transition: opacity .18s ease, transform .18s ease;
}
.design-note[hidden] { display: none; }

.note-card {
  width: min(368px, calc(100vw - 44px - 32px));
  overflow: hidden; padding: 10px 12px;
  border: 1px solid rgba(255, 255, 255, .28); border-radius: 13px;
  background: rgba(0, 0, 0, .80);
  box-shadow: 0 12px 36px rgba(0, 0, 0, .26);
  backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  cursor: grab; touch-action: none; user-select: none;
}
.note-card:focus-visible { outline: none; }
.design-note.is-dragging .note-card { cursor: grabbing; }

/* 批注永远是主角：外观不随界面状态变化，也不加任何内部状态标记。
   定位失败时页面安静停住——内部状态只回对话里说，不进材料。 */

.note-drag-handle {
  display: block; width: 100%; min-width: 0; padding: 4px;
  border: 0; border-radius: 7px; background: transparent;
  color: inherit; cursor: grab; text-align: left;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .86);
  touch-action: none; user-select: none;
}
.note-drag-handle:hover { background: rgba(255, 255, 255, .055); }
.design-note.is-dragging .note-drag-handle { cursor: grabbing; }
.note-drag-handle p {
  margin: 0; color: rgba(255, 255, 255, .94);
  font-size: 14px; font-weight: 400; line-height: 1.58; letter-spacing: .005em;
}
/* 一句话里只有一个词加粗：它是"去界面哪儿看"的抓手 */
.note-drag-handle strong { color: #fff; font-weight: 680; }

/* 竖排 ↑↓：比横排省宽度，视线不离开句子 */
.note-controls { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
.note-controls .icon-button {
  width: 24px; height: 24px; padding: 0; border: 0; background: transparent;
  color: rgba(255, 255, 255, .94);
  /* 双层阴影：纯白箭头落在浅色界面上会几乎消失，靠阴影立住 */
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .55)) drop-shadow(0 0 3px rgba(0, 0, 0, .35));
}
.note-controls .icon-button:hover,
.note-controls .icon-button:active { background: rgba(0, 0, 0, .48); color: #fff; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
.note-controls .icon-button:disabled { cursor: default; opacity: .36; }
.note-controls .icon-button:disabled:hover { background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
.note-controls .icon-button svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

/* ============================================================
   目录 —— 点批注条打开。不放封面，避免剧透
   ============================================================ */
.chapter-menu {
  position: absolute; z-index: 6;
  left: max(22px, env(safe-area-inset-left));
  bottom: calc(max(22px, env(safe-area-inset-bottom)) + 58px);
  width: min(372px, calc(100vw - 44px));
  max-height: min(72vh, 620px); overflow: auto;
  padding: 14px; border: 1px solid var(--line); border-radius: 13px;
  background: #fff; box-shadow: 0 16px 44px rgba(22, 28, 44, .18);
}
.menu-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 10px; border-bottom: 1px solid #efeff0; font-size: 13px; }
.menu-chapter { padding: 10px 0 5px; }
.menu-chapter + .menu-chapter { border-top: 1px solid #f0f0f1; }
.menu-chapter-title { display: flex; align-items: center; gap: 8px; width: 100%; padding: 4px 2px 7px; border: 0; background: transparent; text-align: left; cursor: pointer; font-size: 12px; font-weight: 680; }
.menu-chapter-title span:first-child { color: #838690; font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
.menu-point { display: flex; width: 100%; align-items: flex-start; gap: 9px; padding: 7px 9px; border: 0; border-radius: 7px; background: transparent; color: #696c75; cursor: pointer; text-align: left; font-size: 11px; line-height: 1.45; }
.menu-point:hover, .menu-point.is-current { background: #f1f2fa; color: #353b67; }
.menu-point span:first-child { flex: 0 0 auto; color: #92949c; font: 10px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
.menu-closing-item { margin-top: 5px; border-top: 1px solid #f0f0f1; padding-top: 12px; }

/* 右上角：全屏 / 返回桌面 */
.mobile-return {
  position: absolute; z-index: 4; top: max(16px, env(safe-area-inset-top)); right: max(18px, env(safe-area-inset-right));
  min-height: 34px; padding: 0 12px; border: 1px solid rgba(224, 225, 229, .92); border-radius: 8px;
  background: rgba(255, 255, 255, .9); color: #555963; cursor: pointer; font-size: 11px;
  backdrop-filter: blur(12px);
}
.mobile-return:hover { background: #fff; }
.fullscreen-button {
  position: absolute; z-index: 4; top: max(17px, env(safe-area-inset-top)); right: max(20px, env(safe-area-inset-right));
  display: grid; width: 34px; height: 34px; place-items: center;
  border: 1px solid rgba(224, 225, 229, .9); border-radius: 8px;
  background: rgba(255, 255, 255, .88); color: #666a73; cursor: pointer; font-size: 19px;
  backdrop-filter: blur(12px);
}
.fullscreen-button:hover { color: var(--ink); background: #fff; }

/* 小屏分支：批注条让位，只留返回 */
.showcase.is-mobile .fullscreen-button { display: none; }
.showcase.is-mobile .mobile-return { display: inline-flex !important; align-items: center; gap: 7px; }
.showcase.is-mobile .design-note { display: none !important; }

/* 顶部居中的载入胶囊 */
.loading-state {
  position: absolute; z-index: 3; top: 18px; left: 50%;
  display: flex; align-items: center; gap: 9px;
  padding: 7px 11px; border: 1px solid rgba(224, 225, 229, .9); border-radius: 999px;
  background: rgba(255, 255, 255, .92); color: #747780; font-size: 11px;
  transform: translateX(-50%);
}
.loading-state span { width: 8px; height: 8px; border: 1.5px solid #c8cad1; border-top-color: #6979ce; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

[hidden] { display: none !important; }

/* ---------- 响应式 ---------- */
@media (max-width: 900px) {
  .chapter-cover { padding: 20px 22px 17px; }
  .cover-main { grid-template-columns: 1fr; gap: 23px; align-content: center; padding: 24px 0; }
  .cover-art-stage { width: min(100%, 480px); max-height: 27vh; aspect-ratio: 2 / 1; }
  .cover-eyebrow { margin-bottom: 12px; }
  .cover-number { margin-bottom: 8px; }
  .cover-description { margin-top: 13px; font-size: 13px; }
  .cover-voices { gap: 8px; margin-top: 11px; }
  .cover-voice blockquote { font-size: 12px; }
  .cover-actions { margin-top: 18px; }
  .cover-footer { font-size: 10px; }
  .closing-page { padding: 20px 22px 17px; }
  .closing-main { gap: 26px; padding: 24px 0; }
  .closing-voice { min-height: 260px; padding: 22px; }
  .closing-voice blockquote { font-size: 22px; }
  .closing-footer { font-size: 12px; }
}

@media (max-width: 560px) {
  .cover-brand { gap: 7px; font-size: 9px; letter-spacing: .1em; }
  .cover-brand > i { width: 18px; }
  .cover-brand-lockup img { width: 59px; height: 30px; }
  .cover-main { gap: 18px; }
  .cover-footer span:last-child { display: none; }
  .closing-page { overflow: auto; grid-template-rows: auto auto auto; padding-bottom: max(17px, env(safe-area-inset-bottom)); }
  .closing-heading h1 { font-size: 32px; }
  .closing-voices { grid-template-columns: 1fr; }
  .closing-voice { min-height: 170px; padding: 20px 22px; }
  .closing-voice + .closing-voice { border-top: 1px solid rgba(104, 111, 139, .16); border-left: 0; }
  .closing-voice blockquote { min-height: 74px; margin: 8px 0 14px; font-size: 22px; }
  .closing-mark { top: 38px; }
  .closing-footer { align-items: flex-start; flex-direction: column; }
  .closing-actions { width: 100%; justify-content: space-between; gap: 12px; }
  .design-note { left: 10px; bottom: max(10px, env(safe-area-inset-bottom)); max-width: calc(100vw - 20px); }
  .note-card { width: min(340px, calc(100vw - 20px - 32px)); }
  .chapter-menu { left: 10px; bottom: calc(max(10px, env(safe-area-inset-bottom)) + 55px); width: min(360px, calc(100vw - 20px)); }
  .note-drag-handle p { font-size: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
